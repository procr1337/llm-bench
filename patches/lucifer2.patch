+
+def test_dsv4_flashinfer_sm120_cache_view_for_fp8():
+    fp8_cache = torch.empty((2, 3, 512), dtype=torch.float8_e4m3fn)
+    sm120_cache = dsv4_flashinfer._as_sparse_sm120_cache(fp8_cache)
