+    assert wrapper.call is not None
+    assert wrapper.call["q"].shape == (2, 1, 4, 512)
+    assert wrapper.call["kv_cache"].shape == (2, 4, 1, 512)
+    assert wrapper.call["sparse_indices"].shape == (2, 1, 5)
+    assert wrapper.call["out"].shape == (2, 4, 512)
