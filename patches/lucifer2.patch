+
+def test_cuda_selector_returns_flashinfer_sparse_sm120_backend(monkeypatch):
+    try:
+        from vllm.platforms.cuda import CudaPlatform
+    except (ImportError, ModuleNotFoundError):
+        pytest.skip("CudaPlatform not available")
+
+    monkeypatch.setattr(
